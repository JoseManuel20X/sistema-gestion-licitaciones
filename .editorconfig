root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

# Convenciones de nombres y estilo C#
dotnet_sort_system_directives_first = true
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
# Los miembros de interfaz son públicos por definición; escribir el modificador
# solo añade ruido. Se exige en todo lo demás.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# El vocabulario del dominio se escribe en español (plan-xp.md, estándares de
# código), por lo que los sufijos que exigen algunas reglas de análisis en inglés
# no aplican. Se desactivan de forma explícita y justificada, no globalmente.
dotnet_diagnostic.CA1710.severity = none

# Las migraciones las genera Entity Framework Core: no se editan a mano y no
# tiene sentido exigirles el estilo del código escrito por personas.
[**/Migraciones/*.cs]
generated_code = true

[*.{json,yaml,yml}]
indent_size = 2

[*.{md,csproj,props,targets,sln}]
indent_size = 2
trim_trailing_whitespace = false

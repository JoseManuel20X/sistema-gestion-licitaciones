@model IReadOnlyList<TipoCambioDto>
@{
    ViewData["Title"] = "Tipo de cambio";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Tipo de cambio</h1>
    <a class="btn btn-primary" asp-action="Crear">Nuevo tipo de cambio</a>
</div>

<p class="text-body-secondary">
    Los montos oficiales se almacenan siempre en colones. El tipo de cambio se
    administra aquí, de modo que el sistema funciona sin acceso a Internet, y solo
    uno puede estar activo para la operación ordinaria.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning" role="status">
        No hay tipos de cambio registrados. Sin uno activo no es posible mostrar
        montos en dólares.
    </div>
}
else
{
    <div class="tabla-responsive">
        <table class="table table-striped align-middle">
            <caption class="visually-hidden">Tipos de cambio registrados</caption>
            <thead>
                <tr>
                    <th scope="col" class="text-end">Colones por dólar</th>
                    <th scope="col">Vigencia</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tipoCambio in Model)
                {
                    <tr>
                        <td class="monto">@tipoCambio.CRCporUSD.ToString("N4")</td>
                        <td>@tipoCambio.FechaVigencia.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (tipoCambio.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!tipoCambio.Activo)
                            {
                                <form method="post" asp-action="Activar" asp-route-id="@tipoCambio.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Editar" asp-route-id="@tipoCambio.Id">Editar</a>
                            @if (!tipoCambio.Activo)
                            {
                                <form method="post" asp-action="Eliminar" asp-route-id="@tipoCambio.Id"
                                      class="d-inline"
                                      data-confirmar="¿Eliminar este tipo de cambio?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

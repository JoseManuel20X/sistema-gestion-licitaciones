@model IReadOnlyList<LicitacionDto>
@{
    ViewData["Title"] = "Licitaciones";
    var consulta = (ParametrosConsulta)ViewBag.Consulta;

    string ClaseEstado(string estado) => estado switch
    {
        "Borrador" => "estado-borrador",
        "Publicada" => "estado-publicada",
        _ => "estado-cerrada",
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Licitaciones</h1>
    <a class="btn btn-primary" asp-action="Crear">Nueva licitación</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="filtro" class="form-label small">Buscar por código o título</label>
        <input type="search" class="form-control" id="filtro" name="filtro"
               value="@consulta.Filtro" placeholder="LIC-2026-001" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label for="ordenarPor" class="form-label small">Ordenar por</label>
        <select class="form-select" id="ordenarPor" name="ordenarPor">
            <option value="fechacierre" selected="@(consulta.OrdenarPor is null or "fechacierre")">Fecha de cierre</option>
            <option value="codigo" selected="@(consulta.OrdenarPor == "codigo")">Código</option>
            <option value="presupuesto" selected="@(consulta.OrdenarPor == "presupuesto")">Presupuesto</option>
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="descendente" name="descendente"
                   value="true" checked="@consulta.Descendente" />
            <label class="form-check-label small" for="descendente">Descendente</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        No hay licitaciones que coincidan con la búsqueda.
    </div>
}
else
{
    <div class="tabla-responsive">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">Listado de licitaciones</caption>
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Título</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Cierre</th>
                    <th scope="col" class="text-end">Presupuesto (CRC)</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var licitacion in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Detalle" asp-route-id="@licitacion.Id">@licitacion.Codigo</a>
                        </td>
                        <td>@licitacion.Titulo</td>
                        <td class="@ClaseEstado(licitacion.EstadoEfectivo)">
                            @licitacion.EstadoEfectivo
                            @if (licitacion.Vencida && licitacion.Estado == "Publicada")
                            {
                                @* El campo persistido aún dice Publicada pero la fecha de
                                   cierre ya pasó, así que funcionalmente está cerrada (§8.1). *@
                                <span class="badge text-bg-warning ms-1">vencida</span>
                            }
                        </td>
                        <td>@licitacion.FechaCierre.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="monto">@licitacion.PresupuestoEstimadoCRC.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Detalle" asp-route-id="@licitacion.Id">Ver</a>

                            @if (licitacion.EstadoEfectivo != "Cerrada")
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Editar" asp-route-id="@licitacion.Id">Editar</a>
                            }

                            <form method="post" asp-action="Eliminar" asp-route-id="@licitacion.Id"
                                  class="d-inline"
                                  data-confirmar="¿Eliminar la licitación «@licitacion.Codigo»?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Paginacion", (PaginacionViewModel)ViewBag.Paginacion)
}

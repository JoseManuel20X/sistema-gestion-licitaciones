@model IReadOnlyList<OfertaDto>
@{
    ViewData["Title"] = "Ofertas";
    var licitacionId = ViewBag.LicitacionId as Guid?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Ofertas</h1>
    @if (licitacionId is not null)
    {
        <a class="btn btn-outline-secondary btn-sm"
           asp-controller="Licitaciones" asp-action="Detalle" asp-route-id="@licitacionId">
            Volver a la licitación
        </a>
    }
</div>

@if (licitacionId is not null)
{
    <div class="alert alert-secondary py-2 small" role="status">
        Mostrando solo las ofertas de una licitación.
        <a asp-action="Index">Ver todas</a>
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        No hay ofertas registradas.
    </div>
}
else
{
    <div class="tabla-responsive">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">Listado de ofertas presentadas</caption>
            <thead>
                <tr>
                    <th scope="col">Proveedor</th>
                    <th scope="col" class="text-end">Monto (CRC)</th>
                    <th scope="col">Registrada</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oferta in Model)
                {
                    <tr>
                        <td>@(oferta.NombreProveedor ?? "—")</td>
                        <td class="monto" data-monto-crc="@oferta.MontoOfertadoCRC.ToString(CultureInfo.InvariantCulture)">@oferta.MontoOfertadoCRC.ToString("N2")</td>
                        <td>@oferta.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Paginacion", (PaginacionViewModel)ViewBag.Paginacion)
}

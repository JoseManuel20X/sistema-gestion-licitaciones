@model IReadOnlyList<ProveedorDto>
@{
    ViewData["Title"] = "Proveedores";
    var consulta = (ParametrosConsulta)ViewBag.Consulta;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Proveedores</h1>
    <a class="btn btn-primary" asp-action="Crear">Nuevo proveedor</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="filtro" class="form-label small">Buscar por nombre</label>
        <input type="search" class="form-control" id="filtro" name="filtro"
               value="@consulta.Filtro" placeholder="Nombre del proveedor" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label for="ordenarPor" class="form-label small">Ordenar por</label>
        <select class="form-select" id="ordenarPor" name="ordenarPor">
            <option value="nombre" selected="@(consulta.OrdenarPor != "createdat")">Nombre</option>
            <option value="createdat" selected="@(consulta.OrdenarPor == "createdat")">Fecha de registro</option>
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="descendente" name="descendente"
                   value="true" checked="@consulta.Descendente" />
            <label class="form-check-label small" for="descendente">Descendente</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        No hay proveedores que coincidan con la búsqueda.
    </div>
}
else
{
    <div class="tabla-responsive">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">Listado de proveedores registrados</caption>
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Registrado</th>
                    <th scope="col">Última modificación</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in Model)
                {
                    <tr>
                        <td>@proveedor.Nombre</td>
                        <td>@proveedor.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@proveedor.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Editar" asp-route-id="@proveedor.Id">Editar</a>

                            @* data-confirmar activa la confirmación previa exigida por el §8.9. *@
                            <form method="post" asp-action="Eliminar" asp-route-id="@proveedor.Id"
                                  class="d-inline"
                                  data-confirmar="¿Eliminar el proveedor «@proveedor.Nombre»?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Paginacion", (PaginacionViewModel)ViewBag.Paginacion)
}
